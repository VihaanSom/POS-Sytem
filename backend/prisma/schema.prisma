// Prisma Schema for DashPoint POS System
// Configured for PostgreSQL (local pgAdmin / PostgreSQL 18)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  WAITER

  @@map("user_role")
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED

  @@map("table_status")
}

enum OrderType {
  DINE_IN
  TAKE_OUT
  DELIVERY

  @@map("order_type")
}

enum OrderStatus {
  PENDING
  IN_PROCESS
  READY
  COMPLETED
  CANCELLED

  @@map("order_status")
}

enum PaymentMethod {
  CASH
  CARD
  UPI

  @@map("payment_method")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  REFUNDED
  FAILED

  @@map("payment_status")
}

enum ReservationStatus {
  CONFIRMED
  SEATED
  CANCELLED

  @@map("reservation_status")
}

// ----------------------------------------------------
// MODELS
// ----------------------------------------------------

model User {
  id           Int       @id @default(autoincrement()) @map("user_id")
  username     String    @unique @db.VarChar(50)
  email        String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(100)
  role         UserRole  @default(CASHIER)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")

  orders       Order[]

  @@map("users")
}

model Category {
  id           Int        @id @default(autoincrement()) @map("category_id")
  name         String     @unique @db.VarChar(50)
  slug         String     @unique @db.VarChar(50)
  iconUrl      String?    @map("icon_url") @db.VarChar(255)
  displayOrder Int        @default(0) @map("display_order")

  menuItems    MenuItem[]

  @@map("categories")
}

model MenuItem {
  id          Int         @id @default(autoincrement()) @map("item_id")
  categoryId  Int         @map("category_id")
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String      @db.VarChar(100)
  description String?     @db.Text
  price       Decimal     @db.Decimal(10, 2)
  imageUrl    String?     @map("image_url") @db.VarChar(500)
  badge       String?     @db.VarChar(50)
  isAvailable Boolean     @default(true) @map("is_available")
  createdAt   DateTime    @default(now()) @map("created_at")

  orderItems  OrderItem[]

  @@index([categoryId])
  @@map("menu_items")
}

model RestaurantTable {
  id              Int            @id @default(autoincrement()) @map("table_id")
  tableNumber     String         @unique @map("table_number") @db.VarChar(10)
  seatingCapacity Int            @default(4) @map("seating_capacity")
  status          TableStatus    @default(AVAILABLE)

  orders          Order[]
  reservations    Reservation[]

  @@map("restaurant_tables")
}

model Order {
  id             Int         @id @default(autoincrement()) @map("order_id")
  orderCode      String      @unique @map("order_code") @db.VarChar(20)
  tableId        Int?        @map("table_id")
  table          RestaurantTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  userId         Int?        @map("user_id")
  user           User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  customerName   String      @default("Guest") @map("customer_name") @db.VarChar(100)
  orderType      OrderType   @default(DINE_IN) @map("order_type")
  status         OrderStatus @default(IN_PROCESS)
  subtotal       Decimal     @default(0.00) @db.Decimal(10, 2)
  taxRate        Decimal     @default(10.00) @map("tax_rate") @db.Decimal(5, 2)
  taxAmount      Decimal     @default(0.00) @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal     @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount    Decimal     @default(0.00) @map("total_amount") @db.Decimal(10, 2)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  orderItems     OrderItem[]
  payment        Payment?

  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        Int       @id @default(autoincrement()) @map("order_item_id")
  orderId   Int       @map("order_id")
  order     Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemId    Int?      @map("item_id")
  menuItem  MenuItem? @relation(fields: [itemId], references: [id], onDelete: Restrict)
  itemName  String    @map("item_name") @db.VarChar(100)
  unitPrice Decimal   @map("unit_price") @db.Decimal(10, 2)
  quantity  Int
  lineTotal Decimal   @map("line_total") @db.Decimal(10, 2)
  notes     String?   @db.VarChar(255)

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id             Int           @id @default(autoincrement()) @map("payment_id")
  orderId        Int           @unique @map("order_id")
  order          Order         @relation(fields: [orderId], references: [id], onDelete: Restrict)
  paymentMethod  PaymentMethod @map("payment_method")
  amountPaid     Decimal       @map("amount_paid") @db.Decimal(10, 2)
  paymentStatus  PaymentStatus @default(COMPLETED) @map("payment_status")
  transactionRef String?       @map("transaction_ref") @db.VarChar(100)
  paidAt         DateTime      @default(now()) @map("paid_at")

  @@map("payments")
}

model Reservation {
  id              Int               @id @default(autoincrement()) @map("reservation_id")
  customerName    String            @map("customer_name") @db.VarChar(100)
  customerPhone   String?           @map("customer_phone") @db.VarChar(20)
  tableId         Int?              @map("table_id")
  table           RestaurantTable?  @relation(fields: [tableId], references: [id], onDelete: SetNull)
  guestCount      Int               @map("guest_count")
  reservationTime DateTime          @map("reservation_time")
  status          ReservationStatus @default(CONFIRMED)
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")

  @@index([reservationTime])
  @@map("reservations")
}

model RestaurantSettings {
  id                  Int      @id @default(autoincrement()) @map("setting_id")
  restaurantName      String   @default("DashPoint Restaurant") @map("restaurant_name") @db.VarChar(100)
  defaultTaxRate      Decimal  @default(10.00) @map("default_tax_rate") @db.Decimal(5, 2)
  defaultDiscountRate Decimal  @default(0.00) @map("default_discount_rate") @db.Decimal(5, 2)
  currencySymbol      String   @default("$") @map("currency_symbol") @db.VarChar(5)
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("restaurant_settings")
}
